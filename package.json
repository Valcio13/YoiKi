{
  "name": "yoiki",
  "private": true,
  "workspaces": [
    "frontend",
    "worker"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"worker,frontend\" -c \"cyan,magenta\" \"npm run dev:worker\" \"npm run dev:frontend\"",
    "start": "npm run dev",
    "dev:worker": "npm --prefix worker run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "db:migrate": "npm --prefix worker run db:migrate"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.64.1"
  }
}
